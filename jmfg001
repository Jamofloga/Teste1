

<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculadora</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #101827, #1e293b);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.calculadora {
    background: #111827;
    width: 100%;
    max-width: 350px;
    padding: 25px;
    border-radius: 25px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.4);
}

.display {
    background: #0b1220;
    color: white;
    min-height: 100px;
    padding: 20px;
    border-radius: 15px;
    margin-bottom: 20px;
    text-align: right;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
}

#expressao {
    color: #94a3b8;
    font-size: 18px;
    min-height: 25px;
}

#resultado {
    font-size: 36px;
    font-weight: bold;
    overflow-wrap: anywhere;
}

.botoes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

button {
    border: none;
    height: 65px;
    border-radius: 15px;
    font-size: 22px;
    font-weight: bold;
    cursor: pointer;
    color: white;
    background: #263449;
    transition: 0.2s;
}

button:active {
    transform: scale(0.95);
}

button:hover {
    filter: brightness(1.2);
}

.operador {
    background: #f59e0b;
    color: #111827;
}

.especial {
    background: #475569;
}

.igual {
    background: #10b981;
    grid-row: span 2;
    height: 142px;
}

.zero {
    grid-column: span 2;
}

</style>
</head>

<body>

<div class="calculadora">

    <div class="display">
        <div id="expressao"></div>
        <div id="resultado">0</div>
    </div>

    <div class="botoes">

        <button class="especial" onclick="limpar()">C</button>
        <button class="especial" onclick="apagar()">⌫</button>
        <button class="operador" onclick="percentagem()">%</button>
        <button class="operador" onclick="operacao('/')">÷</button>

        <button onclick="numero('7')">7</button>
        <button onclick="numero('8')">8</button>
        <button onclick="numero('9')">9</button>
        <button class="operador" onclick="operacao('*')">×</button>

        <button onclick="numero('4')">4</button>
        <button onclick="numero('5')">5</button>
        <button onclick="numero('6')">6</button>
        <button class="operador" onclick="operacao('-')">−</button>

        <button onclick="numero('1')">1</button>
        <button onclick="numero('2')">2</button>
        <button onclick="numero('3')">3</button>
        <button class="operador" onclick="operacao('+')">+</button>

        <button class="zero" onclick="numero('0')">0</button>
        <button onclick="decimal()">.</button>
        <button class="igual" onclick="calcular()">=</button>

    </div>
</div>

<script>

let valorAtual = "0";
let valorAnterior = null;
let operador = null;
let reiniciar = false;

const resultado = document.getElementById("resultado");
const expressao = document.getElementById("expressao");

function atualizar() {
    resultado.textContent = valorAtual;
}

function numero(n) {
    if (reiniciar) {
        valorAtual = n;
        reiniciar = false;
    } else {
        valorAtual = valorAtual === "0" ? n : valorAtual + n;
    }

    atualizar();
}

function decimal() {
    if (reiniciar) {
        valorAtual = "0.";
        reiniciar = false;
    } else if (!valorAtual.includes(".")) {
        valorAtual += ".";
    }

    atualizar();
}

function operacao(op) {
    if (operador !== null && !reiniciar) {
        calcular();
    }

    valorAnterior = parseFloat(valorAtual);
    operador = op;
    reiniciar = true;

    expressao.textContent =
        valorAnterior + " " + simbolo(op);

}

function simbolo(op) {
    return {
        "+": "+",
        "-": "−",
        "*": "×",
        "/": "÷"
    }[op];
}

function calcular() {
    if (operador === null || valorAnterior === null) {
        return;
    }

    let atual = parseFloat(valorAtual);
    let resultadoFinal;

    switch (operador) {
        case "+":
            resultadoFinal = valorAnterior + atual;
            break;

        case "-":
            resultadoFinal = valorAnterior - atual;
            break;

        case "*":
            resultadoFinal = valorAnterior * atual;
            break;

        case "/":
            if (atual === 0) {
                valorAtual = "Erro";
                atualizar();
                operador = null;
                valorAnterior = null;
                reiniciar = true;
                return;
            }

            resultadoFinal = valorAnterior / atual;
            break;
    }

    expressao.textContent =
        valorAnterior + " " +
        simbolo(operador) + " " +
        atual + " =";

    valorAtual = String(
        parseFloat(resultadoFinal.toPrecision(12))
    );

    operador = null;
    valorAnterior = null;
    reiniciar = true;

    atualizar();
}

function percentagem() {
    valorAtual = String(parseFloat(valorAtual) / 100);
    atualizar();
}

function apagar() {
    if (reiniciar) {
        return;
    }

    valorAtual = valorAtual.length > 1
        ? valorAtual.slice(0, -1)
        : "0";

    atualizar();
}

function limpar() {
    valorAtual = "0";
    valorAnterior = null;
    operador = null;
    reiniciar = false;

    expressao.textContent = "";
    atualizar();
}

// Suporte ao teclado
document.addEventListener("keydown", function(event) {

    if (event.key >= "0" && event.key <= "9") {
        numero(event.key);
    }

    if (event.key === ".") {
        decimal();
    }

    if (event.key === "+") {
        operacao("+");
    }

    if (event.key === "-") {
        operacao("-");
    }

    if (event.key === "*") {
        operacao("*");
    }

    if (event.key === "/") {
        operacao("/");
    }

    if (event.key === "Enter" || event.key === "=") {
        calcular();
    }

    if (event.key === "Backspace") {
        apagar();
    }

    if (event.key === "Escape") {
        limpar();
    }

});

</script>

</body>
</html>
